# Copie este archivo como .env y cambie los valores. Nunca suba .env al repositorio.
# Use contraseñas sin caracteres especiales de URL (@ : / ? # %), porque van dentro de DATABASE_URL.

# Contraseña del rol dueño del esquema (lo usan solo las migraciones).
POSTGRES_PASSWORD=cambie-esta-clave-propietario
# Contraseña del rol de la aplicación (solo lectura y escritura de datos, sin DDL).
DIAMANTE_APP_PASSWORD=cambie-esta-clave-app

# desarrollo | pruebas | produccion
DIAMANTE_ENTORNO=produccion
# Etiqueta de la imagen del backend.
VERSION=local
