# Copie este archivo como .env y cambie los valores. Nunca suba .env al repositorio.
# Use contraseñas sin caracteres especiales de URL (@ : / ? # %), porque van dentro de DATABASE_URL.

# Contraseña del rol dueño del esquema (lo usan solo las migraciones).
POSTGRES_PASSWORD=cambie-esta-clave-propietario
# Contraseña del rol de la aplicación (solo lectura y escritura de datos, sin DDL).
DIAMANTE_APP_PASSWORD=cambie-esta-clave-app

# desarrollo | pruebas | produccion
DIAMANTE_ENTORNO=produccion
# Etiqueta de la imagen del backend.
VERSION=local

# URL pública del sitio, sin barra final (obligatoria en producción). Los enlaces de los
# correos (invitaciones y recuperación de contraseña) apuntan aquí.
DIAMANTE_URL_PUBLICA=https://diamante.co
# Orígenes adicionales permitidos en peticiones que modifican datos, separados por comas.
# El de DIAMANTE_URL_PUBLICA siempre está permitido.
DIAMANTE_ORIGENES=
# true solo si la API está detrás de un proxy de confianza (Caddy): la IP del cliente se toma
# de X-Forwarded-For para los límites de intentos.
DIAMANTE_CONFIAR_PROXY=false
# Rutas de apoyo para pruebas (GET /api/v1/_pruebas/mensajes con los WhatsApp en cola). Los
# archivos docker-compose.override.yml y docker-compose.e2e.yml la activan; en producción debe
# quedar en false: si vale true, la API no arranca.
DIAMANTE_PRUEBAS_E2E=false

# Correo saliente (SMTP). Sin DIAMANTE_SMTP_HOST, los correos quedan en cola sin enviarse.
# Seguridad: starttls (puerto 587 por defecto) | tls (465) | ninguna (solo desarrollo).
DIAMANTE_SMTP_HOST=
DIAMANTE_SMTP_PUERTO=
DIAMANTE_SMTP_SEGURIDAD=starttls
DIAMANTE_SMTP_USUARIO=
DIAMANTE_SMTP_CLAVE=
DIAMANTE_SMTP_REMITENTE=Diamante Barbería <no-responder@diamante.co>

# Clave para firmar las URL de descarga de documentos (32 caracteres o más).
# Genere una con: openssl rand -base64 48
DIAMANTE_CLAVE_FIRMA=
# Clave AES-256 de los datos sensibles de los barberos (32 bytes en base64).
# Genere una con: openssl rand -base64 32  — ¡guárdela! Sin ella no se pueden leer esos datos.
DIAMANTE_CLAVE_CIFRADO=
